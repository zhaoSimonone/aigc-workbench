{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Bridge Task",
  "type": "object",
  "required": ["taskId", "status", "objective", "resultFile", "allowed", "forbidden", "stopConditions", "successCriteria"],
  "properties": {
    "taskId": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready_for_zcode", "approved"]},
    "objective": {"type": "string", "minLength": 1},
    "resultFile": {"type": "string", "minLength": 1},
    "allowed": {"type": "array", "items": {"type": "string"}},
    "forbidden": {"type": "array", "items": {"type": "string"}},
    "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "successCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "approval": {"type": "object"}
  }
}
