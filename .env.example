# Only use these values in a server-side upload service.
TENCENT_COS_BUCKET=aigc-1257258774
TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=

# Rem video look generation defaults. Keep the API key in your local environment,
# never commit it to this file or the repository.
IMAGE_API_BASE=https://hairfree.corp.kuaishou.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=high
IMAGE_ENDPOINT_MODE=generations
IMAGE_API_KEY=

# 百度网盘目录渲染
# 网盘根目录白名单，只有该前缀下的目录节点可以写进工作台
NETDISK_ROOT_PATH=/AIGC
# 百度网盘 Access Token 仅存在本机 Skill 配置（环境变量 BAIDU_NETDISK_ACCESS_TOKEN
# 或 ~/.config/aigc-workbench/baidu_netdisk_token），不进入服务器、数据库和前端。
# 本地目录归档与工作文档备份（仅服务端读取，切勿使用 VITE_* 前缀）
# 允许归档的源目录白名单，冒号分隔；未配置时归档接口全部拒绝。
ARCHIVE_ALLOWED_SOURCE_ROOTS=/Users/simon/Desktop/AIGC
# 旧版对象存储归档的目标后端。视频备份请走百度网盘，不要用这条链路。
# local 仅用于开发或外置盘，同盘复制不会释放空间。
ARCHIVE_STORAGE_BACKEND=cos
# local 后端的归档根目录，必须在源目录之外
ARCHIVE_LOCAL_ROOT=/Volumes/AIGC-Archive
ARCHIVE_COS_PREFIX=archives
ARCHIVE_MAX_CONCURRENCY=2
ARCHIVE_MAX_RETRIES=3
# 文本在线预览上限（字节），超过只提供下载
ARCHIVE_TEXT_PREVIEW_MAX_BYTES=1048576
# COS 复用上面的 TENCENT_COS_* 配置，不要在此重复填写密钥
