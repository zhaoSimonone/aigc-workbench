# Only use these values in a server-side upload service.
TENCENT_COS_BUCKET=aigc-1257258774
TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=

# Rem video look generation defaults. Keep the API key in your local environment,
# never commit it to this file or the repository.
IMAGE_API_BASE=https://hairfree.corp.kuaishou.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=high
IMAGE_ENDPOINT_MODE=generations
IMAGE_API_KEY=

# 百度网盘目录渲染
# 网盘根目录白名单，只有该前缀下的目录节点可以写进工作台
NETDISK_ROOT_PATH=/AIGC
# 加密用户在网页里保存的百度网盘 Token（32 字节 Base64）。生成：openssl rand -base64 32
# 不要把真实密钥提交进 Git。没有该变量时，工作台不能保存网盘授权，实时目录读取不可用。
NETDISK_TOKEN_ENCRYPTION_KEY=
# 上传/下载用的百度 Token 仍建议只放本机 Skill（BAIDU_NETDISK_ACCESS_TOKEN 或
# ~/.config/aigc-workbench/baidu_netdisk_token）；工作台那枚只用于 list。
# COS 复用上面的 TENCENT_COS_* 配置，不要在此重复填写密钥
